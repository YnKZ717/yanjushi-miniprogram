.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx; }
.list { background: #FFFDF8; border-radius: 24rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.item {
  display: flex; align-items: flex-start;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.item:last-child { border-bottom: none; }
.icon {
  width: 100rpx; height: 100rpx;
  background: rgba(44,95,78,0.08);
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; margin-right: 24rpx; flex-shrink: 0;
}
.info { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 700; color: var(--color-text); margin-bottom: 6rpx; }
.meta { font-size: 22rpx; color: var(--color-text-secondary); margin-bottom: 10rpx; }
.desc { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.6; }
.right { margin-left: 20rpx; text-align: right; flex-shrink: 0; }
.price { color: var(--color-accent); font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.btn {
  padding: 12rpx 28rpx;
  background: var(--color-primary);
  color: #FFFDF8;
  border-radius: 100rpx;
  font-size: 22rpx;
  display: inline-block;
}
