.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx 60rpx; }
.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}
.title { font-size: 32rpx; font-weight: 700; color: var(--color-text); margin-bottom: 24rpx; }
.content {
  font-size: 26rpx;
  line-height: 2;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}
.b-btn {
  width: 100%;
  padding: 26rpx 0;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #2C5F4E, #4A8B76);
  font-size: 28rpx;
  border: none;
}
