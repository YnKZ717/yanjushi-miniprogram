<view class="home-page">
  <view class="banner-area">
    <view class="banner-item" bindtap="goMbti">
      <view class="b-icon">{{banners[0].mark}}</view>
      <view class="b-info">
        <view class="b-title">{{banners[0].title}}</view>
        <view class="b-sub">{{banners[0].sub}}</view>
      </view>
      <view class="b-cta">{{banners[0].cta}} ›</view>
    </view>
    <view class="banner-item adopt-banner" bindtap="goAdopt">
      <view class="b-icon">{{banners[1].mark}}</view>
      <view class="b-info">
        <view class="b-title">{{banners[1].title}}</view>
        <view class="b-sub">{{banners[1].sub}}</view>
      </view>
      <view class="b-cta">{{banners[1].cta}} ›</view>
    </view>
  </view>

  <view class="floor">
    <view class="floor-header">
      <view class="f-title t-bar t-bar-stone">颜料名客房</view>
      <view class="f-more" bindtap="goRooms">全部客房 ›</view>
    </view>
    <scroll-view scroll-x class="room-scroll" enhanced show-scrollbar="{{false}}">
      <view class="room-row">
        <view class="room-card" wx:for="{{rooms}}" wx:key="id" bindtap="goRoom" data-id="{{item.id}}">
          <view class="r-cover" style="background:linear-gradient(135deg,{{item.color}}55,{{item.color}}aa);">
            <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="r-cover-img" binderror="onRoomCoverError" data-id="{{item.id}}"></image>
            <view wx:else class="cover-label">
              <view class="cl-name" style="font-size:56rpx;">{{item.name}}</view>
              <view class="cl-en" style="font-size:20rpx;">{{item.nameEn}} · {{item.area}}</view>
            </view>
          </view>
          <view class="r-body">
            <view class="r-name">{{item.name}}</view>
            <view class="r-type">{{item.type}} · {{item.area}}</view>
            <view class="r-bottom">
              <view class="r-price">¥{{item.price}}<text class="r-unit">起/晚</text></view>
              <view class="r-tags">
                <text class="r-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" wx:for-index="ti">{{t}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="floor">
    <view class="floor-header">
      <view class="f-title t-bar t-bar-accent">三大主题活动</view>
      <view class="f-more" bindtap="goActivities">全部活动 ›</view>
    </view>
    <view class="act-grid">
      <view class="act-card" wx:for="{{activities}}" wx:key="id" bindtap="goActivity" data-id="{{item.id}}">
        <view class="a-top" style="background:linear-gradient(135deg,{{item.color}}22,{{item.color}}55);">
          <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="a-cover-img" binderror="onActivityCoverError" data-id="{{item.id}}"></image>
          <view wx:else class="cover-label" style="align-items:flex-start;text-align:left;">
            <view class="cl-name" style="font-size:36rpx;letter-spacing:2rpx;">{{item.name}}</view>
            <view class="cl-en" style="font-size:18rpx;">{{item.period}}</view>
          </view>
          <view class="a-tags">
            <text class="a-tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
        </view>
        <view class="a-body">
          <view class="a-name">{{item.name}}</view>
          <view class="a-period">{{item.period}}</view>
          <view class="a-bottom">
            <view class="a-price">¥{{item.priceRange}}</view>
            <view class="a-link">查看 ›</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="floor">
    <view class="floor-header">
      <view class="f-title t-bar t-bar-spring">单项体验</view>
      <view class="f-more" bindtap="goExperience">全部体验 ›</view>
    </view>
    <view class="exp-list">
      <view class="exp-item" wx:for="{{experiences}}" wx:key="id">
        <view class="e-icon" style="background:{{item.color}}1f;color:{{item.color}};">{{item.initial}}</view>
        <view class="e-info">
          <view class="e-name">{{item.name}}</view>
          <view class="e-meta">{{item.duration}} · {{item.tags[0]}}</view>
        </view>
        <view class="e-price">¥{{item.price}}</view>
      </view>
    </view>
  </view>

  <view class="floor brand-story">
    <view class="story-title">关于岩涺石</view>
    <view class="story-sub">Monster Planet Art Inn · 可居住的山野美术馆</view>
    <view class="story-desc">
      由艺术家夫妇历时十一年，将废弃百年老茶厂改造而成。野兽派建筑与达达主义精神视觉语言，融合陶艺、油画、手作与安吉白茶的在地茶事。
    </view>
    <view class="story-tags">
      <text class="s-tag tag-stone">石青</text>
      <text class="s-tag tag-spring">春辰</text>
      <text class="s-tag tag-ochre">赭石</text>
      <text class="s-tag tag-indigo">黛蓝</text>
      <text class="s-tag tag-lotus">藕荷</text>
    </view>
  </view>

  <view class="mall-entry" bindtap="goMall">
    <view class="m-info">
      <view class="m-title t-bar t-bar-gold">岩涺石文创商城</view>
      <view class="m-sub">手绘明信片 · 柴烧怪兽陶塑 · 白茶茶器礼盒</view>
    </view>
    <view class="m-cta">进入 ›</view>
  </view>

  <view class="safe-bottom"></view>
</view>
