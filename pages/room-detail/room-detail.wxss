.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 140rpx; }
.cover {
  height: 480rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #FFFDF8;
  position: relative;
}
.cover-icon { font-size: 120rpx; opacity: 0.5; margin-bottom: 24rpx; }
.cover-name { font-size: 72rpx; font-weight: 700; letter-spacing: 12rpx; text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3); }
.cover-en { font-size: 26rpx; opacity: 0.7; letter-spacing: 6rpx; margin-top: 12rpx; }
.section {
  margin: 24rpx 32rpx 0;
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.title-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12rpx; }
.title { font-size: 34rpx; font-weight: 700; color: var(--color-text); }
.price { color: var(--color-accent); font-size: 34rpx; font-weight: 700; }
.unit { font-size: 22rpx; font-weight: 400; color: var(--color-text-secondary); margin-left: 4rpx; }
.meta { font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 18rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { padding: 6rpx 18rpx; border-radius: 100rpx; font-size: 22rpx; }
.tag-stone { background: rgba(58,90,124,0.1); color: var(--color-stone-blue); }
.h { font-size: 28rpx; font-weight: 700; color: var(--color-text); margin-bottom: 20rpx; letter-spacing: 2rpx; }
.desc { font-size: 26rpx; color: var(--color-text-secondary); line-height: 1.9; }
.amenities { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx 0; }
.a-item { display: flex; align-items: center; }
.a-icon { color: var(--color-primary); font-size: 22rpx; margin-right: 10rpx; }
.a-name { font-size: 24rpx; color: var(--color-text); }
.notice-title { color: var(--color-gold); }
.notice-box {
  background: linear-gradient(135deg, rgba(201,169,97,0.08), rgba(44,95,78,0.06));
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(201,169,97,0.18);
}
.n-item { font-size: 24rpx; color: var(--color-text); line-height: 2.2; }
.n-tagline {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(0,0,0,0.1);
  font-size: 22rpx; color: var(--color-text-secondary);
  text-align: center;
}
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  padding: 20rpx 32rpx 40rpx;
  display: flex; align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}
.b-price { flex: 1; font-size: 38rpx; font-weight: 700; color: var(--color-accent); }
.b-btn { min-width: 240rpx; padding: 22rpx 36rpx; border-radius: 100rpx; font-size: 28rpx; }
