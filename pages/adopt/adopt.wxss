.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 160rpx; }
.hero {
  position: relative;
  padding: 60rpx 32rpx 0;
  background: linear-gradient(160deg, #1a1a1a 0%, #A67C52 70%, #C9A961 100%);
  color: #FFFDF8;
  overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0;
  background: radial-gradient(circle at 30% 30%, rgba(201,169,97,0.3) 0%, transparent 45%);
}
.h-content { position: relative; z-index: 2; text-align: center; padding: 40rpx 0; }
.h-title { font-size: 56rpx; font-weight: 700; letter-spacing: 8rpx; margin-bottom: 16rpx; text-shadow: 0 2rpx 16rpx rgba(0,0,0,0.25); }
.h-price { font-size: 64rpx; font-weight: 700; color: #FFFDF8; margin-bottom: 10rpx; }
.h-price .unit { font-size: 28rpx; font-weight: 400; opacity: 0.7; }
.h-sub { font-size: 24rpx; opacity: 0.8; letter-spacing: 4rpx; }

.progress-card {
  position: relative; z-index: 3;
  margin-bottom: -50rpx;
  background: #FFFDF8;
  color: var(--color-text);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.1);
}
.p-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.p-label { font-size: 24rpx; color: var(--color-text-secondary); }
.p-num { font-size: 36rpx; font-weight: 700; color: var(--color-accent); }
.p-total { font-size: 22rpx; font-weight: 400; color: var(--color-text-secondary); }
.p-wrap {
  height: 18rpx;
  background: rgba(166,124,82,0.12);
  border-radius: 100rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.p-fill {
  height: 100%;
  background: linear-gradient(90deg, #C44536 0%, #C9A961 100%);
  border-radius: 100rpx;
  transition: width 0.6s ease;
}
.p-remain { text-align: right; font-size: 22rpx; color: var(--color-text-secondary); }
.r-n { color: var(--color-accent); font-weight: 700; }

.section {
  margin: 72rpx 32rpx 0;
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.h-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.h-bar { width: 10rpx; height: 32rpx; border-radius: 6rpx; margin-right: 14rpx; flex-shrink: 0; }
.h-row .h-title { font-size: 30rpx; font-weight: 700; color: var(--color-text); }

.tree-desc {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}
.tree-row {
  display: flex;
  background: linear-gradient(135deg, rgba(77,124,79,0.08), rgba(201,169,97,0.08));
  border-radius: 20rpx;
  padding: 24rpx 0;
}
.t-col {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  border-right: 1rpx solid rgba(0,0,0,0.06);
}
.t-col:last-child { border-right: none; }
.t-num { font-size: 30rpx; font-weight: 700; color: var(--color-primary); margin-bottom: 6rpx; }
.t-l { font-size: 20rpx; color: var(--color-text-secondary); }

.incl { display: flex; flex-direction: column; gap: 14rpx; }
.i-item { font-size: 26rpx; color: var(--color-text); line-height: 1.6; }

.story-wall {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}
.story-item {
  background: linear-gradient(135deg, #FFF8F0, #FFFDF8);
  border: 1rpx solid rgba(166,124,82,0.12);
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}
.s-icon {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 12rpx;
  font-size: 40rpx; font-weight: 700;
}
.s-name { font-size: 22rpx; font-weight: 600; color: var(--color-text); margin-bottom: 4rpx; }
.s-owner { font-size: 18rpx; color: var(--color-text-secondary); line-height: 1.4; }

.safe-bottom { height: 40rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  padding: 20rpx 32rpx 40rpx;
  display: flex; align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}
.p { flex: 1; }
.p .n { font-size: 40rpx; font-weight: 700; color: var(--color-accent); }
.p .u { font-size: 24rpx; color: var(--color-text-secondary); margin-left: 4rpx; }
.b-btn { min-width: 280rpx; padding: 24rpx 32rpx; border-radius: 100rpx; font-size: 28rpx; background: linear-gradient(135deg, #C44536, #A67C52); }
.b-btn.btn-disabled { background: #ccc; }
