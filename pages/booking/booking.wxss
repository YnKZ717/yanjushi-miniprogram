.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx 140rpx; }
.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.h { font-size: 26rpx; font-weight: 700; color: var(--color-text); margin-bottom: 20rpx; letter-spacing: 2rpx; }
.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0 24rpx;
  border-bottom: 1rpx dashed var(--color-border);
  margin-bottom: 10rpx;
}
.item-cover {
  width: 140rpx; height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.cover-img { width: 100%; height: 100%; }
.cover-emoji { font-size: 60rpx; }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.item-type { font-size: 22rpx; color: var(--color-text-muted); }
.item-name { font-size: 30rpx; color: var(--color-text); }
.item-price { font-size: 28rpx; color: var(--color-accent); font-weight: 700; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.row:last-child { border-bottom: none; }
.k { font-size: 26rpx; color: var(--color-text-secondary); }
.v { font-size: 26rpx; color: var(--color-text); }
.v.bold { font-weight: 700; color: var(--color-primary); }
.picker { font-size: 26rpx; color: var(--color-text); display: flex; align-items: center; }
.caret { color: var(--color-text-muted); margin-left: 8rpx; }
.stepper { display: flex; align-items: center; gap: 20rpx; }
.stp-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(44,95,78,0.08);
  color: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700;
}
.stp-btn.plus { background: var(--color-primary); color: #FFFDF8; }
.stp-num { font-size: 28rpx; font-weight: 600; width: 60rpx; text-align: center; }

.f-row {
  display: flex; align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.f-row:last-child { border-bottom: none; }
.f-row.f-col { flex-direction: column; align-items: flex-start; }
.f-label { width: 150rpx; font-size: 26rpx; color: var(--color-text-secondary); flex-shrink: 0; }
.f-row.f-col .f-label { margin-bottom: 12rpx; }
.f-input {
  flex: 1; font-size: 26rpx; color: var(--color-text);
  padding: 12rpx 0;
}
.f-textarea {
  width: 100%;
  font-size: 26rpx;
  padding: 12rpx 0;
  color: var(--color-text);
  min-height: 100rpx;
}

.direct-card {
  background: linear-gradient(135deg, rgba(201,169,97,0.08), rgba(44,95,78,0.06));
  border: 1rpx solid rgba(201,169,97,0.2);
  display: flex;
  align-items: flex-start;
}
.dc-icon { font-size: 56rpx; margin-right: 20rpx; flex-shrink: 0; }
.dc-body { flex: 1; }
.dc-title { font-size: 28rpx; font-weight: 700; color: #8a6d2c; margin-bottom: 10rpx; }
.dc-list { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 10rpx; }
.dc-tagline { font-size: 20rpx; color: var(--color-text-muted); text-align: center; }

.agree-row { display: flex; align-items: flex-start; padding: 8rpx 12rpx 24rpx; }
.checkbox {
  width: 36rpx; height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #FFFDF8;
  margin-top: 4rpx;
  flex-shrink: 0;
}
.checkbox.checked { background: var(--color-primary); border-color: var(--color-primary); }
.a-text { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.6; flex: 1; }

.safe-bottom { height: 40rpx; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  padding: 20rpx 32rpx 40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 999;
}
.b-btn {
  width: 100%;
  padding: 26rpx 0;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #2C5F4E, #4A8B76);
  font-size: 30rpx;
  border: none;
}
.b-btn.btn-disabled { background: #ccc; }

.dlg-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.dlg-box {
  width: 100%;
  max-width: 620rpx;
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.12);
}
.dlg-title { font-size: 30rpx; font-weight: 700; color: var(--color-text); margin-bottom: 18rpx; }
.dlg-content { font-size: 26rpx; color: var(--color-text-secondary); line-height: 1.7; white-space: pre-wrap; }
.dlg-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}
.dlg-actions.single { justify-content: flex-end; }
.dlg-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.dlg-btn.cancel {
  background: rgba(0,0,0,0.06);
  color: var(--color-text);
}
.dlg-btn.confirm {
  background: linear-gradient(135deg, #C44536, #E46A5C);
  color: #FFFDF8;
}
