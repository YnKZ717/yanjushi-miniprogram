.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx; }
.empty-state {
  padding: 160rpx 0;
  text-align: center;
}
.e-mark {
  width: 120rpx; height: 120rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(44,95,78,0.10), rgba(201,169,97,0.16));
  border: 2rpx solid rgba(44,95,78,0.12);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 28rpx;
  font-size: 52rpx; font-weight: 700; color: var(--color-primary); opacity: 0.75;
}
.e-text { font-size: 30rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; }
.e-desc { font-size: 24rpx; color: var(--color-text-muted); }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.o-card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.o-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.o-type { font-size: 22rpx; color: var(--color-primary); background: rgba(44,95,78,0.08); padding: 4rpx 16rpx; border-radius: 100rpx; }
.o-status { font-size: 24rpx; font-weight: 700; }
.o-name { font-size: 30rpx; font-weight: 700; color: var(--color-text); margin-bottom: 10rpx; }
.o-meta { font-size: 22rpx; color: var(--color-text-secondary); display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.o-bottom {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--color-border);
}
.o-contact { font-size: 22rpx; color: var(--color-text-muted); }
.o-cta { font-size: 24rpx; color: var(--color-primary); font-weight: 600; }
