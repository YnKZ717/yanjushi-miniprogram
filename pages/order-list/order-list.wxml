<view class="page">
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <view class="e-icon">📋</view>
    <view class="e-text">还没有订单哦</view>
    <view class="e-desc">去首页逛逛～</view>
  </view>
  <view class="list" wx:else>
    <view class="o-card" wx:for="{{list}}" wx:key="orderId" bindtap="goDetail" data-id="{{item.orderId}}">
      <view class="o-top">
        <text class="o-type">{{item.typeText}}</text>
        <text class="o-status" style="color:{{item.statusColor}};">{{item.statusText}}</text>
      </view>
      <view class="o-name">{{item.name}}</view>
      <view class="o-meta">
        <text>{{item.dateText}}</text>
        <text>·</text>
        <text>{{item.guests}}人</text>
      </view>
      <view class="o-bottom">
        <text class="o-contact">{{item.contactName}} · {{item.contactPhone}}</text>
        <text class="o-cta">详情 ›</text>
      </view>
    </view>
  </view>
</view>
