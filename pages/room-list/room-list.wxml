<view class="room-list-page">
  <view class="list">
    <view class="r-item" wx:for="{{rooms}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="r-cover" style="background:linear-gradient(135deg,{{item.color}}33,{{item.color}}99);">
        <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="r-cover-img" binderror="onCoverError" data-id="{{item.id}}"></image>
        <view class="r-label">
          <view class="r-color-name">{{item.name}}</view>
          <view class="r-color-en">{{item.nameEn}} · {{item.area}}</view>
        </view>
      </view>
      <view class="r-body">
        <view class="r-name-row">
          <text class="r-name">{{item.name}}</text>
          <text class="r-name-en">{{item.nameEn}}</text>
        </view>
        <view class="r-type-row">{{item.type}} · {{item.area}} · {{item.beds}} · {{item.maxGuests}}人</view>
        <view class="r-tags">
          <text class="r-tag tag-stone" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="r-bottom">
          <view class="r-price">¥{{item.price}}<text class="r-unit">起/晚</text></view>
          <view class="r-book">查看详情 ›</view>
        </view>
      </view>
    </view>
  </view>
</view>
