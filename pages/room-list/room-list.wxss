.room-list-page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx; }
.list { display: flex; flex-direction: column; gap: 24rpx; }
.r-item {
  background: #FFFDF8;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.r-cover {
  height: 280rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  position: relative;
}
.r-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.r-label { position: absolute; left: 28rpx; bottom: 20rpx; }
.r-color-name {
  font-size: 44rpx; font-weight: 700;
  color: rgba(255, 253, 248, 0.92);
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.25);
}
.r-color-en {
  font-size: 18rpx;
  color: rgba(255, 253, 248, 0.7);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  margin-top: 4rpx;
}
.r-body { padding: 28rpx 32rpx 32rpx; }
.r-name-row { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 8rpx; }
.r-name { font-size: 36rpx; font-weight: 700; color: var(--color-text); }
.r-name-en { font-size: 22rpx; color: var(--color-text-muted); letter-spacing: 4rpx; text-transform: uppercase; }
.r-type-row { font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 18rpx; }
.r-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 22rpx; }
.r-tag { padding: 6rpx 18rpx; border-radius: 100rpx; font-size: 20rpx; background: rgba(58,90,124,0.1); color: var(--color-stone-blue); }
.r-bottom { display: flex; justify-content: space-between; align-items: center; }
.r-price { color: var(--color-accent); font-size: 34rpx; font-weight: 700; }
.r-unit { font-size: 22rpx; font-weight: 400; color: var(--color-text-secondary); }
.r-book { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }
