<view class="login-page">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <image
      wx:if="{{!bannerHide}}"
      class="hero-cover"
      src="{{bannerSrc}}"
      mode="aspectFill"
      binderror="onBannerError"
      lazy-load="{{false}}"
      show-menu-by-longpress="{{false}}"
      key="{{bannerSrc}}"></image>
    <view class="hero-bottom-fade"></view>
  </view>

  <view class="login-content">
    <view class="brand-area">
      <view class="brand-name">岩涺石 <text class="brand-en">Monster Planet</text></view>
      <view class="brand-slogan">住进颜料的名字里，带走未被规训的自己</view>
    </view>

    <view class="cta-area">
      <view class="cta-title">欢迎来到岩涺石</view>
      <view class="cta-desc">测你的专属怪兽人格，逛客房和活动，直接预约下单</view>

      <button
        class="btn-primary btn-block login-btn"
        bindtap="doLogin"
        hover-class="btn-hover"
        loading="{{loading}}"
      >
        微信登录 开始测试
      </button>

      <view class="agree-row" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="check-icon">✓</text>
        </view>
        <text class="agree-text">
          我已阅读并同意
          <text class="link" catchtap="openPrivacy">《用户隐私协议》</text>
        </text>
      </view>
    </view>
  </view>
</view>
