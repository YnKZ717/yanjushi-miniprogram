.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #17342b;
}

.hero-section {
  position: relative;
  width: 100%;
  height: 42vh;
  overflow: hidden;
  flex-shrink: 0;
  background: #17342b;
}

.hero-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-bottom-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(23, 52, 43, 0) 0%, #17342b 100%);
  pointer-events: none;
}

.login-content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 58vh;
  padding: 42rpx 64rpx 80rpx;
  background: #17342b;
}

.brand-area {
  text-align: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.mark-line {
  width: 58rpx;
  height: 2rpx;
  background: #cdb47d;
}

.mark-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 16rpx;
  border-radius: 50%;
  background: #cdb47d;
}

.brand-name {
  color: #fffaf0;
  font-size: 82rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 8rpx;
  white-space: nowrap;
}

.brand-en {
  margin-top: 10rpx;
  color: #d6be8f;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}

.cta-area {
  margin-top: 11vh;
}

.login-intro {
  margin-bottom: 28rpx;
  color: #e8d9b0;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
  white-space: nowrap;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 48rpx;
  background: #e9d3a5;
  color: #19352b;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.login-btn::after {
  border: none;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  white-space: nowrap;
}

.checkbox {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  border: 2rpx solid #d6be8f;
  border-radius: 7rpx;
}

.checkbox.checked {
  background: #d6be8f;
  border-color: #d6be8f;
}

.check-icon {
  color: #19352b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  color: rgba(255, 250, 240, 0.78);
  font-size: 22rpx;
  white-space: nowrap;
}

.link {
  color: #e9d3a5;
}
