.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 82% 72%, rgba(201, 169, 97, 0.24) 0%, transparent 48%),
    linear-gradient(180deg, #2C5F4E 0%, #1E4439 52%, #142A24 100%);
  position: relative;
  padding: 0 0 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.hero-section {
  position: relative;
  width: 100%;
  height: 42vh;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: #1E4439;
  z-index: 0;
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-bottom-fade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(201, 169, 97, 0.18) 42%, #1E4439 100%);
  pointer-events: none;
  z-index: 2;
}

.login-content {
  position: relative;
  z-index: 3;
  padding: 48rpx 60rpx 0;
}

.brand-area {
  text-align: center;
  margin-bottom: 56rpx;
}

.brand-name {
  font-size: 58rpx;
  font-weight: 700;
  color: #FFFDF8;
  letter-spacing: 8rpx;
}

.brand-en {
  font-size: 28rpx;
  font-weight: 400;
  color: #E8D9B0;
  letter-spacing: 4rpx;
}

.cta-area {
  background: rgba(255, 253, 248, 0.13);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  border: 1rpx solid rgba(255, 253, 248, 0.14);
  box-shadow: 0 12rpx 48rpx rgba(20, 42, 36, 0.45);
}

.cta-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFDF8;
  text-align: center;
  margin-bottom: 40rpx;
}

.login-btn {
  background: linear-gradient(135deg, #C44536 0%, #C9A961 100%);
  color: #1A120F;
  font-size: 30rpx;
  padding: 28rpx;
  border-radius: 100rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 32rpx rgba(201, 169, 97, 0.32);
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  margin-top: 32rpx;
}

.checkbox {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.4);
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--color-gold);
  border-color: var(--color-gold);
}

.check-icon {
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255, 253, 248, 0.5);
  white-space: nowrap;
}

.link {
  color: var(--color-gold);
}
