.login-page {
  min-height: 100vh;
  background-image: url('https://cdn.jsdelivr.net/gh/YnKZ717/yanjushi-miniprogram@18527c089a15cf521fb0b8ace5dcb643a864e421/pics/login/login-bg4.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  position: relative;
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bg-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 70% 20%, rgba(201, 169, 97, 0.18) 0%, transparent 55%),
              radial-gradient(circle at 20% 80%, rgba(196, 69, 54, 0.14) 0%, transparent 55%),
              linear-gradient(180deg, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0.12) 50%, rgba(0,0,0,0.32) 100%);
  pointer-events: none;
}

.login-content {
  position: relative;
  z-index: 2;
  padding-top: 80rpx;
}

.brand-area {
  text-align: center;
  margin-bottom: 80rpx;
}

.brand-logo {
  position: relative;
  width: 264rpx;
  height: 236rpx;
  margin: 0 auto 20rpx;
}

.logo-m {
  position: absolute;
  border-radius: 26rpx;
  border: 3rpx solid rgba(255, 253, 248, 0.5);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.35);
  background: #1f1f1f;
}
.logo-m1 { width: 132rpx; height: 132rpx; left: 2rpx; top: 26rpx; transform: rotate(-8deg); z-index: 4; }
.logo-m2 { width: 112rpx; height: 112rpx; right: 0; top: 0; transform: rotate(6deg); z-index: 3; }
.logo-m3 { width: 104rpx; height: 104rpx; left: 0; bottom: 0; transform: rotate(-4deg); z-index: 2; }
.logo-m4 { width: 96rpx; height: 96rpx; right: 18rpx; bottom: 6rpx; transform: rotate(10deg); z-index: 1; }

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFDF8;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.brand-en {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-gold);
  letter-spacing: 4rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255, 253, 248, 0.7);
  letter-spacing: 2rpx;
  margin-top: 24rpx;
}

.cta-area {
  background: rgba(255, 253, 248, 0.06);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(255, 253, 248, 0.1);
}

.cta-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFDF8;
  text-align: center;
  margin-bottom: 12rpx;
}

.cta-desc {
  font-size: 24rpx;
  color: rgba(255, 253, 248, 0.6);
  text-align: center;
  margin-bottom: 48rpx;
}

.login-btn {
  background: linear-gradient(135deg, #C44536 0%, #C9A961 100%);
  color: #FFFDF8;
  font-size: 30rpx;
  padding: 28rpx;
  border-radius: 100rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(196, 69, 54, 0.35);
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.4);
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--color-gold);
  border-color: var(--color-gold);
}

.check-icon {
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255, 253, 248, 0.5);
}

.link {
  color: var(--color-gold);
}
