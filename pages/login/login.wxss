.login-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 62%, rgba(201, 169, 97, 0.38) 0%, transparent 52%),
    radial-gradient(circle at 22% 88%, rgba(201, 169, 97, 0.18) 0%, transparent 60%),
    radial-gradient(circle at 50% 50%, #2C5F4E 0%, #1E4439 58%, #142A24 100%);
  position: relative;
  padding: 0 0 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.hero-section {
  position: relative;
  width: 100%;
  height: 42vh;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #1a1a1a 0%, #2C5F4E 75%, #1E4439 100%);
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.hero-bottom-fade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 180rpx;
  background: linear-gradient(180deg, transparent 0%, #1E4439 100%);
  pointer-events: none;
  z-index: 2;
}

.login-content {
  position: relative;
  z-index: 3;
  padding: 48rpx 60rpx 0;
}

.brand-area {
  text-align: center;
  margin-bottom: 72rpx;
}

.brand-name {
  font-size: 58rpx;
  font-weight: 700;
  color: #FFFDF8;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.brand-en {
  font-size: 28rpx;
  font-weight: 400;
  color: #E8D9B0;
  letter-spacing: 4rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255, 253, 248, 0.78);
  letter-spacing: 2rpx;
  margin-top: 24rpx;
}

.cta-area {
  background: rgba(255, 253, 248, 0.09);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(255, 253, 248, 0.12);
  box-shadow: 0 12rpx 48rpx rgba(20, 42, 36, 0.5);
}

.cta-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFDF8;
  text-align: center;
  margin-bottom: 14rpx;
}

.cta-desc {
  font-size: 24rpx;
  color: rgba(255, 253, 248, 0.72);
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.login-btn {
  background: linear-gradient(135deg, #C44536 0%, #C9A961 100%);
  color: #1A120F;
  font-size: 30rpx;
  padding: 28rpx;
  border-radius: 100rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 32rpx rgba(201, 169, 97, 0.32);
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.4);
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox.checked {
  background: var(--color-gold);
  border-color: var(--color-gold);
}

.check-icon {
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255, 253, 248, 0.5);
}

.link {
  color: var(--color-gold);
}
