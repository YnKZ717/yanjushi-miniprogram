.result-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.hero-section {
  position: relative;
  padding: 60rpx 48rpx 120rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.32;
  mix-blend-mode: overlay;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
}

.p-badge {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 32rpx;
  border-radius: 44rpx;
  overflow: hidden;
  display: block;
  background: transparent;
  border: none;
}

.p-badge-fallback {
  background: rgba(255, 253, 248, 0.12);
  border: 2rpx solid rgba(255, 253, 248, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFDF8;
  backdrop-filter: blur(10rpx);
}

.p-name {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFDF8;
  letter-spacing: 12rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.p-name-en {
  font-size: 26rpx;
  color: rgba(255, 253, 248, 0.55);
  letter-spacing: 6rpx;
  margin-bottom: 24rpx;
  text-transform: uppercase;
}

.p-mbti-wrap {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 36rpx;
}

.p-mbti {
  padding: 6rpx 22rpx;
  background: rgba(255, 253, 248, 0.12);
  color: rgba(255, 253, 248, 0.85);
  border-radius: 100rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(255, 253, 248, 0.18);
}

.p-tagline {
  font-size: 28rpx;
  color: rgba(255, 253, 248, 0.85);
  font-style: italic;
  letter-spacing: 2rpx;
  line-height: 1.6;
  max-width: 600rpx;
  margin: 0 auto;
}

.content-section {
  margin-top: -60rpx;
  padding: 0 32rpx;
  position: relative;
  z-index: 2;
}

.card {
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-label {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-muted);
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

.desc-text {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--color-text);
  letter-spacing: 0.5rpx;
}

.scores-card .score-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.s-name {
  width: 200rpx;
  font-size: 24rpx;
  color: var(--color-text);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.s-dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.s-bar {
  flex: 1;
  height: 14rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 100rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.s-fill {
  height: 100%;
  border-radius: 100rpx;
  transition: width 0.8s ease;
}

.s-num {
  width: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-align: right;
  flex-shrink: 0;
}

.match-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.match-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.match-item:first-child {
  padding-top: 0;
}

.m-badge {
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.m-info { flex: 1; min-width: 0; }
.m-name { font-size: 28rpx; font-weight: 600; color: var(--color-text); margin-bottom: 4rpx; }
.m-desc { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.5; }

.m-right { margin-left: 16rpx; flex-shrink: 0; text-align: right; }
.m-price { color: var(--color-accent); font-weight: 700; font-size: 26rpx; margin-bottom: 8rpx; }
.m-btn {
  display: inline-block;
  padding: 10rpx 22rpx;
  background: var(--color-primary);
  color: #FFFDF8;
  border-radius: 100rpx;
  font-size: 22rpx;
}

.share-card { text-align: center; }
.share-title { font-size: 32rpx; font-weight: 700; color: var(--color-text); margin-bottom: 12rpx; display: inline-block; text-align: left; }
.share-desc { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 32rpx; }

.share-btns {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.share-btn {
  flex: 1;
  padding: 28rpx 0 24rpx;
  background: var(--color-bg);
  border-radius: 20rpx;
  border: none;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.share-btn::after { border: none; }

.sb-bar { width: 44rpx; height: 10rpx; border-radius: 6rpx; margin-bottom: 6rpx; }
.sb-label { font-size: 22rpx; color: var(--color-text); font-weight: 500; }

.adopt-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF4E6, #F5EEDF);
  border: 1rpx solid rgba(166, 124, 82, 0.15);
}

.adopt-left { margin-right: 20rpx; }
.adopt-icon {
  width: 88rpx; height: 88rpx;
  background: #FFFDF8;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: var(--color-ochre);
}
.adopt-info { flex: 1; }
.adopt-title { font-size: 28rpx; font-weight: 700; color: var(--color-ochre); margin-bottom: 4rpx; }
.adopt-sub { font-size: 22rpx; color: var(--color-text-secondary); }
.adopt-btn {
  padding: 14rpx 26rpx;
  background: var(--color-ochre);
  color: #FFFDF8;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.retake-row {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.retake-link {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.safe-bottom { height: 80rpx; }

.poster-mask, .share-modal-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.poster-modal {
  width: 100%;
  max-height: 90vh;
  background: #FFFDF8;
  border-radius: 36rpx 36rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.pm-header, .sm-header {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pm-title, .sm-title {
  font-size: 30rpx; font-weight: 700; color: var(--color-text);
}

.pm-close, .sm-close {
  font-size: 32rpx;
  color: var(--color-text-muted);
  padding: 0 8rpx;
}

.pm-body {
  flex: 1;
  padding: 32rpx;
  overflow: auto;
  text-align: center;
}

.gen-spinner {
  width: 80rpx; height: 80rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin: 120rpx auto 24rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.gen-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.poster-img {
  width: 100%;
  max-width: 560rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.pm-tips {
  margin-top: 32rpx;
  text-align: left;
}

.tip-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 2;
}

.pm-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 48rpx;
}

.pm-actions .btn-outline, .pm-actions .btn-primary {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 28rpx;
}

.pm-save {
  background: linear-gradient(135deg, #2C5F4E, #4A8B76);
  color: #FFFDF8;
  border: none;
}

.share-modal-mask { align-items: flex-end; }
.share-modal {
  width: 100%;
  background: #FFFDF8;
  border-radius: 36rpx 36rpx 0 0;
  animation: slideUp 0.3s ease;
}
.sm-body {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  gap: 24rpx;
}
.sm-item {
  flex: 1;
  padding: 32rpx 0 20rpx;
  border-radius: 24rpx;
  background: var(--color-bg);
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.sm-item::after { border: none; }
.sm-icon-wrap {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 8rpx;
}
.sm-char { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.sm-wx { background: rgba(44, 95, 78, 0.12); }
.sm-pyq { background: rgba(201, 169, 97, 0.18); }
.sm-pyq .sm-char { color: #8a6d2c; }
.sm-label { font-size: 26rpx; font-weight: 600; color: var(--color-text); }
.sm-sub { font-size: 20rpx; color: var(--color-text-muted); }
