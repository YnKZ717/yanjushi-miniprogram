.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx 160rpx; }
.status-card {
  background: linear-gradient(135deg, #FFFDF8, #FFF4E6);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex; align-items: flex-start;
  border: 1rpx solid;
  margin-bottom: 24rpx;
}
.s-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 20rpx; margin-top: 6rpx;
  box-shadow: 0 0 0 8rpx rgba(44,95,78,0.08);
  flex-shrink: 0;
}
.s-body { flex: 1; }
.s-text { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.s-desc { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.6; }

.stepper {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.step { display: flex; align-items: flex-start; padding-bottom: 22rpx; position: relative; }
.step:not(:last-child)::after {
  content: ''; position: absolute; left: 9rpx; top: 28rpx; bottom: 0;
  width: 2rpx; background: var(--color-border);
}
.dot {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  background: var(--color-border);
  margin-right: 20rpx; margin-top: 6rpx;
  flex-shrink: 0;
  position: relative; z-index: 1;
}
.dot.active { background: var(--color-primary); box-shadow: 0 0 0 6rpx rgba(44,95,78,0.15); }
.step-body { flex: 1; padding-bottom: 4rpx; }
.step-name { font-size: 26rpx; font-weight: 600; color: var(--color-text); margin-bottom: 4rpx; }
.step-desc { font-size: 22rpx; color: var(--color-text-secondary); }

.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.h { font-size: 26rpx; font-weight: 700; margin-bottom: 20rpx; color: var(--color-text); letter-spacing: 2rpx; }
.row {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 14rpx 0; border-bottom: 1rpx solid var(--color-border);
}
.row:last-child { border-bottom: none; }
.k { font-size: 26rpx; color: var(--color-text-secondary); flex-shrink: 0; width: 160rpx; }
.v { font-size: 26rpx; color: var(--color-text); text-align: right; flex: 1; }
.v.bold { font-weight: 700; color: var(--color-primary); }
.v.small { font-size: 22rpx; word-break: break-all; }
.v.clickable { color: var(--color-primary); }

.wx-card {
  background: linear-gradient(135deg, rgba(44,95,78,0.06), rgba(201,169,97,0.08));
  border: 1rpx solid rgba(44,95,78,0.15);
  display: flex; align-items: center;
}
.wx-icon { font-size: 48rpx; margin-right: 20rpx; flex-shrink: 0; }
.wx-body { flex: 1; }
.wx-title { font-size: 28rpx; font-weight: 700; color: var(--color-primary); margin-bottom: 6rpx; }
.wx-desc { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.6; }
.wx-btn {
  padding: 14rpx 28rpx;
  background: var(--color-primary);
  color: #FFFDF8;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  padding: 20rpx 32rpx 40rpx;
  display: flex; gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}
.bottom-bar .btn-outline, .bottom-bar .btn-primary {
  flex: 1; padding: 24rpx 0; border-radius: 100rpx; font-size: 28rpx;
}
.bottom-bar .btn-primary { background: linear-gradient(135deg, #2C5F4E, #4A8B76); border: none; }
.safe-bottom { height: 40rpx; }

.qr-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.65);
  z-index: 100; display: flex; align-items: center; justify-content: center;
}
.qr-modal {
  width: 80%;
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 40rpx;
  text-align: center;
}
.qr-title { font-size: 30rpx; font-weight: 700; margin-bottom: 28rpx; }
.qr-img {
  width: 100%; aspect-ratio: 1;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.qr-sub { font-size: 22rpx; color: var(--color-text-secondary); margin-top: 12rpx; }
.qr-tip { font-size: 22rpx; color: var(--color-text-muted); margin-bottom: 28rpx; }
.qr-close {
  padding: 20rpx 0;
  background: var(--color-bg);
  border-radius: 100rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.info-card {
  background: linear-gradient(135deg, rgba(201,169,97,0.05), rgba(44,95,78,0.04));
  border: 1rpx dashed rgba(201,169,97,0.45);
}
.copy-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: 20rpx;
}
.full-width {
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100rpx !important;
  padding: 22rpx 0 !important;
}

.copy-fallback-textarea {
  width: 100%;
  min-height: 420rpx;
  max-height: 800rpx;
  background: #FFFDF8;
  border: 1rpx dashed rgba(201,169,97,0.55);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 24rpx;
  line-height: 2;
  color: #1a1a1a;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.copy-panel .tip-warn {
  color: #C0392B;
  background: rgba(192,57,43,0.06);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: 8rpx 0 18rpx;
  border: 1rpx dashed rgba(192,57,43,0.2);
}

.mini-copy-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 28rpx;
}
.mini-copy {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 18rpx 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2C5F4E;
  background: rgba(44,95,78,0.08);
  border-radius: 100rpx;
}

.copy-card-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a6a2a;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.copy-selectable-text {
  width: 100%;
  min-height: 420rpx;
  max-height: 70vh;
  overflow: auto;
  background: #FFFDF8;
  border: 1rpx dashed rgba(201,169,97,0.55);
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 24rpx;
  line-height: 2;
  color: #1a1a1a;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  word-break: break-all;
  white-space: pre-wrap;
  -webkit-user-select: text;
  user-select: text;
  -webkit-touch-callout: default;
}

.copy-selectable-wrap {
  width: 100%;
  min-height: 420rpx;
  max-height: 70vh;
  overflow: auto;
  background: #FFFDF8;
  border: 1rpx dashed rgba(201,169,97,0.55);
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.copy-line {
  display: block;
  font-size: 24rpx;
  line-height: 2;
  color: #1a1a1a;
  word-break: break-all;
  -webkit-user-select: text;
  user-select: text;
  -webkit-touch-callout: default;
  width: 100%;
}

.mode-switch {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
}
.mode-switch-inner {
  display: flex;
  background: rgba(0,0,0,0.04);
  border-radius: 100rpx;
  padding: 6rpx;
  gap: 6rpx;
}
.mode-btn {
  flex: 1;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  border-radius: 100rpx;
  text-align: center;
  white-space: nowrap;
}
.mode-btn.active {
  background: #2C5F4E;
  color: #FFFDF8;
  box-shadow: 0 4rpx 12rpx rgba(44,95,78,0.2);
}

.copy-block-wrap {
  width: 100%;
  min-height: 420rpx;
  max-height: 70vh;
  overflow: auto;
  background: #FFF9ED;
  border: 2rpx dashed rgba(201,169,97,0.65);
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.copy-block-textarea {
  width: 100%;
  min-height: 380rpx;
  font-size: 25rpx;
  line-height: 2;
  color: #1a1a1a;
  word-break: break-all;
  white-space: pre-wrap;
  -webkit-user-select: text;
  user-select: text;
  -webkit-touch-callout: default;
  background: transparent;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  outline: none;
  border: none;
}
.copy-tip {
  font-size: 24rpx;
  color: #8a6a2a;
  margin-bottom: 4rpx;
  line-height: 1.6;
}

.mini-copy-warn {
  background: rgba(192,57,43,0.08) !important;
  color: #C0392B !important;
}
.mini-share {
  margin: 0;
  border: none;
  background: rgba(44,95,78,0.15) !important;
  color: #2C5F4E !important;
  line-height: normal !important;
  height: auto !important;
}
.mini-share::after { border: none; }

.d-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 999; display: flex; align-items: center; justify-content: center; }
.d-modal {
  width: 620rpx;
  background: #FFFDF8;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.18);
  animation: pop .22s ease;
}
@keyframes pop { from { transform: scale(.9); opacity: 0 } to { transform: scale(1); opacity: 1 } }
.d-title { font-size: 34rpx; font-weight: 700; color: #1a1a1a; text-align: center; margin-bottom: 24rpx; }
.d-content {
  font-size: 26rpx;
  line-height: 2;
  color: #444;
  white-space: pre-wrap;
  max-height: 60vh;
  overflow: auto;
  margin-bottom: 36rpx;
}
.d-btns { display: flex; gap: 20rpx; justify-content: center; align-items: center; }
.d-btn {
  flex: 1;
  min-width: 0;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 100rpx;
}
.d-btn-cancel {
  background: rgba(0,0,0,0.04);
  color: #666;
}
.d-btn-confirm {
  background: linear-gradient(135deg, #2C5F4E, #4A8B76);
  color: #FFFDF8;
}
