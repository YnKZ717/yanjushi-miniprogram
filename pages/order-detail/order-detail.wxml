<view class="page" wx:if="{{order}}">
  <view class="status-card" style="border-color:{{order.statusColor}}33;">
    <view class="s-dot" style="background:{{order.statusColor}};"></view>
    <view class="s-body">
      <view class="s-text" style="color:{{order.statusColor}};">{{order.statusText}}</view>
      <view class="s-desc" wx:if="{{order.status === 'pending'}}">管家将在24小时内联系您确认</view>
      <view class="s-desc" wx:elif="{{order.status === 'confirmed'}}">已添加管家企微的话，可以随时沟通～</view>
      <view class="s-desc" wx:else>感谢您选择岩涺石 Monster Planet</view>
    </view>
  </view>

  <view class="stepper">
    <view class="step" wx:for="{{statusSteps}}" wx:key="key">
      <view class="dot {{order.status === item.key ? 'active' : ''}}"></view>
      <view class="step-body">
        <view class="step-name">{{item.text}}</view>
        <view class="step-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="h">预约内容</view>
    <view class="row"><text class="k">类型</text><text class="v">{{order.typeText}}</text></view>
    <view class="row"><text class="k">项目</text><text class="v bold">{{order.name}}</text></view>
    <view class="row"><text class="k">日期</text><text class="v">{{order.date}}</text></view>
    <view class="row"><text class="k">人数</text><text class="v">{{order.guests}}人</text></view>
    <view class="row" wx:if="{{order.remark}}">
      <text class="k">备注</text>
      <text class="v">{{order.remark}}</text>
    </view>
  </view>

  <view class="card">
    <view class="h">联系人</view>
    <view class="row"><text class="k">姓名</text><text class="v">{{order.contactName}}</text></view>
    <view class="row">
      <text class="k">手机号</text>
      <text class="v clickable" bindtap="copyPhone">{{order.contactPhone}} 复制</text>
    </view>
  </view>

  <view class="card wx-card">
    <view class="wx-icon">💬</view>
    <view class="wx-body">
      <view class="wx-title">添加管家企业微信确认预订</view>
      <view class="wx-desc">· 意向咨询阶段 · 线下确认收款后才算预订成功</view>
    </view>
    <view class="wx-btn" bindtap="addWechat">添加</view>
  </view>

  <view class="card info-card">
    <view class="h">订单信息（可复制）</view>
    <view class="copy-desc">本阶段订单仅保存在本机（清缓存会消失），建议长按复制或点下方按钮一键复制，粘贴发给管家即可完成咨询提交。</view>
    <button class="btn-outline full-width" bindtap="copyOrderDetail">一键复制订单详情</button>
  </view>

  <view class="card" wx:if="{{order.orderId}}">
    <view class="h">订单信息</view>
    <view class="row"><text class="k">订单编号</text><text class="v small">{{order.orderId}}</text></view>
    <view class="row"><text class="k">下单渠道</text><text class="v">{{order.source || '小程序直订'}}</text></view>
    <view class="row"><text class="k">创建时间</text><text class="v small">{{order.createdAtText || '-'}}</text></view>
  </view>

  <view class="bottom-bar" wx:if="{{order.status === 'pending'}}">
    <button class="btn-outline" bindtap="cancel">取消预约</button>
    <button class="btn-primary" bindtap="addWechat">加企微确认</button>
  </view>
  <view class="bottom-bar" wx:elif="{{order.status === 'confirmed'}}">
    <button class="btn-outline" bindtap="addWechat">联系管家</button>
  </view>
  <view class="safe-bottom" wx:else></view>

  <view class="qr-mask" wx:if="{{showQr}}" bindtap="closeQr">
    <view class="qr-modal" catchtap="">
      <view class="qr-title">添加管家企业微信</view>
      <view class="qr-img">📷<view class="qr-sub">管家企微二维码占位</view></view>
      <view class="qr-tip">长按识别 / 截图保存扫码</view>
      <view class="qr-close" bindtap="closeQr">关闭</view>
    </view>
  </view>

  <view class="qr-mask" wx:if="{{showCopyPanel}}" bindtap="closeCopyPanel">
    <view class="qr-modal copy-panel" catchtap="">
      <view class="qr-title">复制订单详情</view>
      <view class="qr-tip tip-warn" wx:if="{{copyFullFailed}}">检测到系统剪贴板暂不可用，可直接**长按下面的文本区域**选择「全选 → 复制」手动带走全部信息；或单独点下面的小按钮分别复制订单号 / 手机号。</view>
      <view class="qr-tip" wx:else>两种方式任选一种：①点绿色大按钮一键复制 ②长按下面的文本区域手动选中文本→复制。</view>
      <button class="btn-primary" style="width:100%;margin: 20rpx 0 16rpx;" bindtap="copyFullNow">
        <text wx:if="{{copyFullDone}}">✅ 已复制成功（可再次点击覆盖）</text>
        <text wx:else>一键复制全部</text>
      </button>

      <view class="mini-copy-row">
        <view class="mini-copy" bindtap="copyOrderId">复制订单号</view>
        <view class="mini-copy" bindtap="copyContactPhone">复制手机号</view>
        <view class="mini-copy" bindtap="copyContactName">复制姓名</view>
      </view>

      <view class="copy-card-title" wx:if="{{copyFullText}}">📝 完整订单详情（长按以下区域可选中文本）</view>
      <view
        class="copy-selectable-text"
        copyable="{{true}}"
        selectable="{{true}}"
        user-select="{{true}}"
        show-confirm-bar="{{false}}"
        select-word="{{true}}">{{copyFullText || '暂无订单信息'}}</view>

      <view class="qr-close" bindtap="closeCopyPanel">关闭</view>
    </view>
  </view>

  <view class="d-mask" wx:if="{{dialogVisible}}" bindtap="_dialogMask">
    <view class="d-modal" catchtap="">
      <view class="d-title">{{dialogTitle}}</view>
      <view class="d-content"><text>{{dialogContent}}</text></view>
      <view class="d-btns">
        <view class="d-btn d-btn-cancel" wx:if="{{dialogShowCancel}}" bindtap="_dialogCancel">{{dialogCancelText}}</view>
        <view class="d-btn d-btn-confirm" bindtap="_dialogConfirm">{{dialogConfirmText}}</view>
      </view>
    </view>
  </view>
</view>
