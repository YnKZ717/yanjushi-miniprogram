.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 140rpx; }
.cover {
  height: 420rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #FFFDF8;
  position: relative;
}
.cover-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.t { font-size: 56rpx; font-weight: 700; letter-spacing: 6rpx; text-shadow: 0 2rpx 16rpx rgba(0,0,0,0.25); }
.sub { font-size: 24rpx; opacity: 0.8; letter-spacing: 2rpx; margin-top: 12rpx; }
.section {
  margin: 24rpx 32rpx 0;
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.type { font-size: 24rpx; color: var(--color-text-secondary); letter-spacing: 4rpx; }
.price { color: var(--color-accent); font-size: 34rpx; font-weight: 700; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag {
  padding: 6rpx 18rpx;
  background: rgba(44,95,78,0.08);
  color: var(--color-primary);
  border-radius: 100rpx;
  font-size: 22rpx;
}
.h { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; color: var(--color-text); letter-spacing: 2rpx; }
.desc { font-size: 26rpx; line-height: 1.9; color: var(--color-text-secondary); }
.incl { display: flex; flex-direction: column; gap: 16rpx; }
.i-item { display: flex; align-items: flex-start; }
.i-check { color: var(--color-primary); margin-right: 10rpx; line-height: 1.5; }
.i-name { font-size: 24rpx; color: var(--color-text); line-height: 1.6; }
.notice .n {
  font-size: 24rpx; color: var(--color-text-secondary); line-height: 2;
}
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  padding: 20rpx 32rpx 40rpx;
  display: flex; align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 10;
}
.b-l { flex: 1; }
.p { color: var(--color-accent); font-size: 36rpx; font-weight: 700; }
.unit { font-size: 22rpx; font-weight: 400; color: var(--color-text-secondary); margin-left: 4rpx; }
.b-btn { min-width: 240rpx; padding: 22rpx 36rpx; border-radius: 100rpx; font-size: 28rpx; }
