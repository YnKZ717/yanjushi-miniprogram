<view class="page" wx:if="{{activity}}">
  <view class="cover" style="background:linear-gradient(160deg,{{activity.color}}33,{{activity.color}}cc);">
    <image wx:if="{{activity.cover}}" src="{{activity.cover}}" mode="aspectFill" class="cover-img" binderror="onCoverError"></image>
    <view wx:if="{{!activity.cover}}" class="t">{{activity.name}}</view>
    <view wx:if="{{!activity.cover}}" class="sub">{{activity.period}}</view>
  </view>
  <view class="section">
    <view class="row">
      <text class="type">{{activity.type}}</text>
      <text class="price">{{activity.id === 'monster-factory-open-day' ? '' : activity.id === 'adopt-plan' ? '参考价 ¥' : '¥'}}{{activity.priceRange}}</text>
    </view>
    <view class="tags">
      <text class="tag" wx:for="{{activity.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
  </view>
  <view class="section">
    <view class="h">活动介绍</view>
    <view class="desc">{{activity.desc}}</view>
  </view>
  <view class="section">
    <view class="h">{{activity.id === 'adopt-plan' || activity.id === 'monster-factory-open-day' ? '方案拟包含' : '活动包含'}}</view>
    <view class="incl">
      <view class="i-item" wx:for="{{activity.include}}" wx:key="*this">
        <text class="i-check">✓</text>
        <text class="i-name">{{item}}</text>
      </view>
    </view>
  </view>
  <view class="section notice">
    <view class="h">{{activity.id === 'adopt-plan' || activity.id === 'monster-factory-open-day' ? '方案说明' : '报名须知'}}</view>
    <view class="n">{{activity.scheduleNote}}</view>
    <view class="n" wx:if="{{activity.id !== 'adopt-plan' && activity.id !== 'monster-factory-open-day'}}">· 预约后将添加管家企业微信确认</view>
    <view class="n" wx:if="{{activity.id === 'kiln-fire-tea'}}">· 限{{activity.limit}}席，16岁以上报名</view>
    <view class="n" wx:if="{{activity.id === 'adopt-plan'}}">· 方案拟首年制作{{activity.limit}}只，尚未开放真实收养</view>
  </view>
  <view class="bottom-bar">
    <view class="b-l">
      <view class="p" wx:if="{{activity.id === 'monster-factory-open-day'}}">价格待定</view>
      <view class="p" wx:else>{{activity.id === 'adopt-plan' ? '参考价 ' : ''}}¥{{activity.price}}<text class="unit">/ {{activity.priceUnit}}</text></view>
    </view>
    <button class="btn-primary b-btn" bindtap="book">{{activity.id === 'monster-factory-open-day' ? '暂未开放' : activity.id === 'adopt-plan' ? '了解收养计划' : '立即预约'}}</button>
  </view>
</view>
