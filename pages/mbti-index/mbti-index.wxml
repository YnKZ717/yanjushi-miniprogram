<view class="mbti-index-page">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="hero-label">MBTI × 怪兽星球</view>
      <view class="hero-title">测测你的内心<br/>住着哪一只怪兽</view>
      <view class="hero-sub">{{questions.length}}道情景题 · 4种人格 · 生成专属海报</view>
    </view>
  </view>

  <view class="result-card" wx:if="{{mbtiResult}}">
    <view class="result-header">
      <view class="persona-badge" style="background:{{mbtiResult.persona.colors.bg}}; border-color:{{mbtiResult.persona.colors.primary}};">
        <text class="persona-icon">{{mbtiResult.persona.icon}}</text>
      </view>
      <view class="result-info">
        <view class="result-label">你上次的测试结果</view>
        <view class="persona-name" style="color:{{mbtiResult.persona.colors.primary}};">{{mbtiResult.persona.name}}</view>
        <view class="persona-mbti">{{mbtiResult.persona.mbtiRange}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="result-actions">
      <button class="btn-outline btn-sm" bindtap="retest">重新测</button>
      <button class="btn-primary btn-sm" bindtap="goResult">查看结果</button>
    </view>
  </view>

  <view class="start-card" wx:else>
    <view class="start-title">还没做过测试？</view>
    <view class="start-sub">花3分钟，找到属于你的那只怪兽</view>
    <button class="btn-primary btn-block start-btn" bindtap="startTest">
      开始测试
    </button>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">🎭 四种怪兽人格</view>
    </view>
    <view class="persona-grid">
      <view class="persona-card card-fire">
        <text class="p-icon">🔥</text>
        <text class="p-name">观火者</text>
        <text class="p-mbti">INFJ/INFP/INTJ</text>
        <text class="p-tag">窑火与茶</text>
      </view>
      <view class="persona-card card-mud">
        <text class="p-icon">🟫</text>
        <text class="p-name">泥巴怪</text>
        <text class="p-mbti">ESFP/ENFP/ESTP</text>
        <text class="p-tag">怪兽收养计划</text>
      </view>
      <view class="persona-card card-earth">
        <text class="p-icon">🪨</text>
        <text class="p-name">大地建造者</text>
        <text class="p-mbti">ISFJ/ESFJ/ENFJ</text>
        <text class="p-tag">石头的口信</text>
      </view>
      <view class="persona-card card-wild">
        <text class="p-icon">🏗️</text>
        <text class="p-name">野生建筑师</text>
        <text class="p-mbti">ISTP/ENTP/INTJ</text>
        <text class="p-tag">柴烧集训营</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">🌿 居民星球</view>
      <view class="section-link" bindtap="goHome">去首页 ›</view>
    </view>

    <view class="resident-card">
      <view class="resident-left">
        <view class="avatar">{{userInfo.avatarUrl ? '' : '🧑'}}</view>
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}"></image>
      </view>
      <view class="resident-info">
        <view class="resident-name">{{userInfo.nickName || '怪兽星球新居民'}}</view>
        <view class="resident-no">居民编号 · {{residentNo}}</view>
      </view>
      <view class="resident-tag">居民</view>
    </view>

    <view class="adopt-progress" bindtap="goAdopt">
      <view class="adopt-title">
        <text class="adopt-icon">👾</text>
        怪兽收养计划
        <text class="adopt-price">¥398</text>
      </view>
      <view class="adopt-sub">首年限量{{adoptTotal}}只 · 每收养一只种一棵白茶树</view>
      <view class="progress-wrap">
        <view class="progress-fill" style="width:{{(1 - adoptRemain/adoptTotal)*100}}%"></view>
      </view>
      <view class="adopt-remain">
        剩余 <text class="remain-num">{{adoptRemain}}</text> 只 · 售罄不补
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title">🔥 三大主题活动</view>
    </view>
    <view class="banner-list">
      <view class="banner-item" wx:for="{{banners}}" wx:key="index" bindtap="goActivity" data-id="{{['adopt-plan','kiln-fire-tea','stone-message'][index]}}">
        <view class="banner-icon">{{item.icon}}</view>
        <view class="banner-info">
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-sub">{{item.sub}}</view>
        </view>
        <view class="banner-tag">{{item.tag}}</view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
