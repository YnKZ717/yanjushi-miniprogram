<view class="mbti-index-page">
  <view class="hero-section">
    <view class="hero-bg"></view>
    <block wx:for="{{heroWmList}}" wx:key="idx" wx:for-item="wm" wx:for-index="idx">
      <image
        wx:if="{{!wm.hide}}"
        class="hero-wm hero-wm{{idx+1}}"
        src="{{wm.src}}"
        mode="aspectFill"
        binderror="onHeroWmError"
        data-idx="{{idx}}"
        key="{{wm.src}}"></image>
    </block>
    <view class="hero-content">
      <view class="hero-title">6 道题，<br/>捣出你的专属怪兽</view>
      <view class="hero-sub">做完生成小红书专属海报，分享给朋友</view>
    </view>
  </view>

  <view class="result-card" wx:if="{{mbtiResult}}">
    <view class="result-header">
      <image wx:if="{{mbtiResult.persona.cover}}" src="{{mbtiResult.persona.cover}}" mode="aspectFill" class="persona-badge persona-avatar" binderror="onMbtiResultAvatarError" key="{{mbtiResult.persona.cover}}"></image>
      <view class="result-info">
        <view class="result-label">你上次的测试结果</view>
        <view class="persona-name" style="color:{{mbtiResult.persona.colors.primary}};">{{mbtiResult.persona.name}}</view>
        <view class="persona-mbti">{{mbtiResult.persona.mbtiRange}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="result-actions">
      <button class="btn-outline btn-sm" bindtap="retest">重新测</button>
      <button class="btn-primary btn-sm" bindtap="goResult">查看结果</button>
    </view>
  </view>

  <view class="start-card" wx:else>
    <view class="start-title">还没做过测试？</view>
    <view class="start-sub">花3分钟，找到属于你的那只怪兽</view>
    <button class="btn-primary btn-block start-btn" bindtap="startTest">
      开始测试
    </button>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title t-bar t-bar-accent">四种怪兽人格</view>
    </view>
    <view class="persona-grid">
      <view class="persona-card card-{{item.key}}" wx:for="{{personas}}" wx:key="key" wx:for-item="item">
        <view class="p-text-col">
          <text class="p-name" style="color:{{item.colors.primary}};">{{item.name}}</text>
          <text class="p-mbti">{{item.mbtiRange}}</text>
          <text class="p-tag">{{item.tagText}}</text>
        </view>
        <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="p-cover" binderror="onPersonaCardCoverError" data-key="{{item.key}}" key="{{item.cover}}"></image>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title t-bar">居民星球</view>
      <view class="section-link" bindtap="goHome">去首页 ›</view>
    </view>

    <view class="resident-card">
      <view class="resident-left" wx:if="{{userInfo.avatarUrl}}">
        <image class="avatar-img" src="{{userInfo.avatarUrl}}"></image>
      </view>
      <view class="resident-info">
        <view class="resident-name">{{userInfo.nickName || '怪兽星球新居民'}}</view>
        <view class="resident-no">居民编号 · {{residentNo}}</view>
      </view>
      <view class="resident-tag">居民</view>
    </view>

    <view class="adopt-progress" bindtap="goAdopt">
      <view class="adopt-title">
        怪兽收养计划
        <text class="adopt-price">参考价 ¥398</text>
      </view>
      <view class="adopt-sub">商赛方案展示 · 拟首年制作100只并配套白茶树种植</view>
      <view class="adopt-remain">尚未开放真实收养</view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <view class="section-title t-bar t-bar-accent">三大主题活动</view>
    </view>
    <view class="banner-list">
      <view class="banner-item" wx:for="{{banners}}" wx:key="index" bindtap="goActivity" data-id="{{['adopt-plan','monster-factory-open-day','kiln-fire-tea'][index]}}">
        <view class="banner-info">
          <view class="banner-title" style="color:{{item.color}};">{{item.title}}</view>
          <view class="banner-sub">{{item.sub}}</view>
        </view>
        <view class="banner-tag">{{item.tag}}</view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
